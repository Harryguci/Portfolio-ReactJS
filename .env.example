# Copy to .env before docker compose up / docker:release

# Single Docker Hub repo (recommended):
#   IMAGE_PREFIX=chuhuy/portfolio
#   → pushes chuhuy/portfolio:api-latest and chuhuy/portfolio:web-latest
IMAGE_PREFIX=chuhuy/portfolio
IMAGE_TAG=latest

PORT=80
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
