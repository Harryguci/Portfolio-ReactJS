# Copy to .env on VPS (runtime) and optionally on local (for build/push tags)

# Registry prefix — Docker Hub: yourusername
# GHCR: ghcr.io/your-github-username
IMAGE_PREFIX=yourdockerhubusername
IMAGE_TAG=latest

PORT=80
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
